# Copy to .env locally. Never commit real credentials.
APP_ENV=local
HOST=127.0.0.1
PORT=8001

# Generate JWT_SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_REFRESH_COOKIE_NAME=news_refresh_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=300

DATABASE_URL=mysql+aiomysql://news_app_user:change-me@127.0.0.1:3306/news_app?charset=utf8mb4
SQL_ECHO=false

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=50

# 可选向量检索。聊天模型密钥不一定支持 Embedding，需单独填写兼容接口。
QDRANT_ENABLED=false
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=news_evidence_v1
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536
EMBEDDING_VERSION=embedding-v1
VECTOR_API_TIMEOUT_SECONDS=30
VECTOR_INDEX_BATCH_SIZE=50
VECTOR_SEARCH_LIMIT=50

# Keep provider credentials on the backend only.
AI_API_BASE_URL=https://api.deepseek.com
AI_API_KEY=replace-with-a-secret
AI_MODEL=deepseek-flash
AI_PROVIDER_NAME=deepseek
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2

APP_TIMEZONE=Asia/Shanghai
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=127.0.0.1,localhost

AGENT_RATE_LIMIT=10
AGENT_RATE_WINDOW_SECONDS=60
AGENT_LOCK_TTL_SECONDS=240

# 定时任务处理管理员启用自动采集的来源；自动发布还需来源可信和分类白名单。
AUTO_PIPELINE_ENABLED=true
AUTO_PIPELINE_INTERVAL_SECONDS=60
# enforce 在所有来源、分类和审核门槛通过后自动发布；改为 shadow 可只记录候选而不发布。
AUTO_PUBLISH_MODE=enforce

